# ==============================================================
# Gaming Cafe — Environment Variables
# Copy this file to .env.local and fill in your Supabase values.
# NEVER commit .env.local or any file containing the service key.
# ==============================================================

# Supabase project URL (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase anon/public key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase service-role key — SERVER ONLY, never expose to the browser.
# Used exclusively inside Next.js route handlers / server components.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the deployed app (used for the booking QR code)
NEXT_PUBLIC_APP_URL=http://localhost:3000
