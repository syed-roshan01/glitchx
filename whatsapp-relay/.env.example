# GlitchX WhatsApp relay — configuration
#
# 1. Copy this file to .env (same folder) and fill in the values.
# 2. `npm install` once, then `npm start`.
# 3. Open Admin → WhatsApp in the app and scan the QR with your phone
#    (WhatsApp → Settings → Linked Devices → Link a Device).

# The GlitchX app this relay serves (Vercel URL or http://localhost:3000)
APP_URL=https://glitchx-nu.vercel.app

# Shared secret — MUST match the WHATSAPP_RELAY_TOKEN value in the app's
# environment (Vercel → Settings → Environment Variables for production,
# or .env.local for a local dev server).
RELAY_TOKEN=change-me-to-a-long-random-string

# Country code prepended to 10-digit customer numbers (India = 91)
COUNTRY_CODE=91
